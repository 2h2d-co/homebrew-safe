amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"

import "package://github.com/2h2d-co/hk-config/releases/download/v0.2.1/hk-config@0.2.1#/Base.pkl" as Base
import "package://github.com/2h2d-co/hk-config/releases/download/v0.2.1/hk-config@0.2.1#/GitHubActions.pkl" as GitHubActions
import "package://github.com/2h2d-co/hk-config/releases/download/v0.2.1/hk-config@0.2.1#/Shell.pkl" as Shell

local projectSteps = (Base.baseSteps) {
  ...Shell.shellSteps
  ...GitHubActions.gitHubActionsSteps
}

display_skip_reasons = Base.displaySkipReasons
hooks = Base.defaultHooks(true, projectSteps)
