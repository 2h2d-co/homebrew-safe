#!/usr/bin/env zsh
#MISE description="Run safe-upgrade --dry-run from this working tree"
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

HOMEBREW_AUTO_UPDATE_CHECKED=1 \
HOMEBREW_NO_AUTO_UPDATE=1 \
HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 \
brew ruby -- -e '
  $LOAD_PATH.unshift(File.expand_path("lib"))
  require_relative "cmd/safe-upgrade"
  Homebrew::Cmd::SafeUpgrade.new(["--dry-run", *ARGV]).run
' -- "$@"
